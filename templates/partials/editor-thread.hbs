{{!--
    The Thread editor. ("node" in code, "Thread" to the reader.)

    Outcomes are one row per Force on the Plot rather than a repeating widget:
    the set is fixed by the roster, so there is nothing to add or remove. A row
    left at zero with nothing written is not saved.

    Prerequisites are chips plus a picker, so a Plot with twenty Threads does not
    become twenty checkboxes.
--}}

<section class="rsr-form-section">
    <p class="rsr-form-note">
        {{localize "RSR.editor.threadOn"}} <strong>{{editor.plotName}}</strong>
    </p>
    <div class="rsr-form-row">
        <label for="rsr-f-name">{{localize "RSR.editor.name"}}</label>
        <input type="text" id="rsr-f-name" name="name" value="{{editor.draft.name}}">
    </div>
    <div class="rsr-form-row is-tall">
        <label for="rsr-f-description">{{localize "RSR.editor.description"}}</label>
        <textarea id="rsr-f-description" name="description" rows="3">{{editor.draft.description}}</textarea>
    </div>
</section>

<section class="rsr-form-section">
    <div class="rsr-form-row">
        <label for="rsr-f-mode">{{localize "RSR.editor.mode"}}</label>
        <select id="rsr-f-mode" name="mode">
            {{#each editor.modes}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>
                {{#if this.isInherit}}
                {{localize this.label mode=(localize @root.editor.inheritedMode)}}
                {{else}}
                {{localize this.label}}
                {{/if}}
            </option>
            {{/each}}
        </select>
    </div>

    <div class="rsr-form-row">
        <label for="rsr-f-threshold">{{localize "RSR.editor.threshold"}}</label>
        <span class="rsr-form-inline">
            <input type="number" id="rsr-f-threshold" name="threshold" min="1"
                   value="{{editor.draft.threshold}}">
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.editor.thresholdHint'}}"></i>
            <label for="rsr-f-segments">{{localize "RSR.editor.segments"}}</label>
            <input type="number" id="rsr-f-segments" name="segments" min="1"
                   value="{{editor.draft.segments}}">
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.editor.segmentsHint'}}"></i>
        </span>
    </div>

    {{!-- Sits under the two numbers it is about: it decides which way they are
          read, not what they are. The label carries its own scope because the
          switch is stored on every Thread and only means something on the two
          modes that have one shared reading — saying so in the label is cheaper
          and steadier than a control that greys itself out a mode change too
          late. --}}
    <div class="rsr-form-row">
        <label for="rsr-f-countdown">{{localize "RSR.editor.countdown"}}</label>
        <span class="rsr-form-check">
            <input type="checkbox" id="rsr-f-countdown" name="countdown"{{#if editor.draft.countdown}} checked{{/if}}>
            <span class="rsr-form-note">{{localize "RSR.editor.countdownScope"}}</span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.editor.countdownHint'}}"></i>
        </span>
    </div>

    <div class="rsr-form-row">
        <label for="rsr-f-status">{{localize "RSR.editor.status"}}</label>
        <select id="rsr-f-status" name="status">
            {{#each editor.statuses}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
        </select>
        <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
           data-tooltip="{{localize 'RSR.editor.statusHint'}}"></i>
    </div>
</section>

{{!-- What concluding this Thread does to the Plot, per Force. --}}
<section class="rsr-form-section">
    <h3>
        {{localize "RSR.editor.outcomes"}}
        <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
           data-tooltip="{{localize 'RSR.editor.outcomesHint'}}"></i>
    </h3>

    {{#if editor.outcomes.length}}
    {{#each editor.outcomes}}
    <div class="rsr-outcome-row">
        <span class="rsr-outcome-force">{{this.name}}</span>
        <input type="number" id="rsr-oc-delta-{{this.forceId}}" class="rsr-outcome-delta"
               data-row-group="outcomes" data-row-key="{{this.forceId}}" data-row-field="delta"
               value="{{this.delta}}">
        <input type="text" id="rsr-oc-note-{{this.forceId}}"
               data-row-group="outcomes" data-row-key="{{this.forceId}}" data-row-field="note"
               value="{{this.note}}" placeholder="{{localize 'RSR.editor.outcomeNotePlaceholder'}}">
    </div>
    {{/each}}
    {{else}}
    <p class="rsr-form-note">{{localize "RSR.editor.noForcesOnPlot"}}</p>
    {{/if}}
</section>

<section class="rsr-form-section">
    <h3>
        {{localize "RSR.editor.prereqs"}}
        <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
           data-tooltip="{{localize 'RSR.editor.prereqsHint'}}"></i>
    </h3>

    {{#if editor.prereqs.length}}
    <div class="rsr-chip-row">
        {{#each editor.prereqs}}
        <span class="rsr-edit-chip">
            <span>{{this.name}}</span>
            <button type="button" class="rsr-icon-btn rsr-icon-tiny" data-action="removePrereq"
                    data-thread-id="{{this.id}}" data-tooltip="{{localize 'RSR.editor.removePrereq'}}">
                <i class="fa-solid fa-xmark" inert></i>
            </button>
        </span>
        {{/each}}
    </div>
    {{else}}
    <p class="rsr-form-note">{{localize "RSR.editor.noPrereqs"}}</p>
    {{/if}}

    {{#if editor.availablePrereqs.length}}
    <div class="rsr-form-add">
        <select id="rsr-pick-prereq" name="pick-prereq">
            <option value="">{{localize "RSR.editor.pickThread"}}</option>
            {{#each editor.availablePrereqs}}
            <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
        </select>
        <button type="button" class="rsr-btn" data-action="addPrereq">
            <i class="fa-solid fa-plus" inert></i>
            <span>{{localize "RSR.editor.addPrereq"}}</span>
        </button>
    </div>
    {{/if}}
</section>
