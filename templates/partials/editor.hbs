{{!--
    The editor shell: back, title, the form, and the Save bar.

    Edit mode renders OVER whatever view is open — the segments stay, the body is
    replaced. Nothing here reaches the world until Save; the draft lives in the
    application instance, and logic/editing.mjs explains why this is the one
    control on the board that does not write immediately.

    Everything inside is a real <form>, because that is what lets the harvest read
    controls by name. Its submit event is swallowed in _onRender: every button in
    here is type="button", but a lone text field would still submit on Enter.
--}}
<div class="rsr-view rsr-view-editor">

    <header class="rsr-editor-head">
        <button type="button" class="rsr-back" data-action="closeEdit">
            <i class="fa-solid fa-chevron-left" inert></i>
            <span>{{localize "RSR.editor.back"}}</span>
        </button>
        <h2 class="rsr-editor-title">
            {{localize editor.title}}
            {{#if editor.name}}<span class="rsr-editor-subject">{{editor.name}}</span>{{/if}}
        </h2>
    </header>

    <form class="rsr-editor-form" autocomplete="off">
        {{#if editor.isPlot}}
        {{> "modules/remito-situation-room/templates/partials/editor-plot.hbs"}}
        {{/if}}
        {{#if editor.isThread}}
        {{> "modules/remito-situation-room/templates/partials/editor-thread.hbs"}}
        {{/if}}
        {{#if editor.isForce}}
        {{> "modules/remito-situation-room/templates/partials/editor-force.hbs"}}
        {{/if}}
        {{#if editor.isAsset}}
        {{> "modules/remito-situation-room/templates/partials/editor-asset.hbs"}}
        {{/if}}
        {{#if editor.isConditions}}
        {{> "modules/remito-situation-room/templates/partials/editor-conditions.hbs"}}
        {{/if}}

        {{!-- What colour this row's name is printed in wherever the board sets it
              in a sentence — which today means the chronicle, where four kinds of
              noun share one paragraph and nothing but the wording told them
              apart. Radios rather than a select: the swatch IS the label, and
              :checked does the whole of the feedback with no script.

              Default leads and is the answer for almost every row. An Asset left
              on Default wears its Force's colour, which is the point of putting
              the same control on a Force. --}}
        {{#if editor.isEntity}}
        <section class="rsr-form-section">
            <h3>{{localize "RSR.editor.appearance"}}</h3>
            <div class="rsr-form-row">
                <label>{{localize "RSR.editor.color"}}</label>
                <span class="rsr-form-inline">
                    <span class="rsr-swatches">
                        {{#each editor.colors}}
                        <label class="rsr-swatch{{#if this.isDefault}} is-default{{else}}{{#if this.isCustom}} is-custom{{else}} rsr-tag-{{this.value}}{{/if}}{{/if}}"
                               {{#if this.isCustom}}{{#if @root.editor.colorCustomHex}}style="--rsr-tag-ink: {{@root.editor.colorCustomHex}}"{{/if}}{{/if}}
                               data-tooltip="{{localize this.label}}">
                            <input type="radio" name="color" value="{{this.value}}"{{#if this.selected}} checked{{/if}}>
                            <span class="rsr-swatch-dot" aria-hidden="true"></span>
                            <span class="rsr-swatch-name">{{localize this.label}}</span>
                        </label>
                        {{/each}}
                    </span>

                    {{!-- The GM's own. Two controls for one stored value: the
                          native picker for choosing, and the text box for a hex
                          or an rgb() pasted from somewhere else. Typing in
                          either selects Custom above; picking a swatch above
                          empties them. That sync is the only script on this
                          form, and it is worth it — without it the row would
                          show one colour selected while the board printed
                          another.

                          The box reads back CANONICALISED after a save, so a GM
                          who typed rgb(138 144 153) sees #8a9099 and knows what
                          was actually kept. --}}
                    <span class="rsr-color-custom" data-color-custom>
                        <input type="color" class="rsr-color-pick" data-color-pick
                               value="{{#if editor.colorCustomHex}}{{editor.colorCustomHex}}{{else}}#888888{{/if}}"
                               aria-label="{{localize 'RSR.editor.colorPick'}}"
                               data-tooltip="{{localize 'RSR.editor.colorPick'}}">
                        <input type="text" class="rsr-color-text" name="colorCustom"
                               value="{{editor.colorCustom}}" placeholder="#8a9099"
                               spellcheck="false" autocomplete="off"
                               aria-label="{{localize 'RSR.editor.colorCustom'}}">
                    </span>
                    <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
                       data-tooltip="{{localize 'RSR.editor.colorHint'}}"></i>
                </span>
            </div>
        </section>
        {{/if}}

        {{!-- What the table sees. Last, and on every editor of a ROW, because it is
              the question a GM answers about a row rather than a property of it.
              The world's condition table is not a row and has no audience. --}}
        {{#if editor.isEntity}}
        <section class="rsr-form-section">
            <h3>{{localize "RSR.settings.tableTitle"}}</h3>
            <div class="rsr-form-row">
                <label for="rsr-f-visibility">{{localize "RSR.editor.visibility"}}</label>
                <span class="rsr-form-inline">
                    <select id="rsr-f-visibility" name="visibility">
                        {{#each editor.visibility}}
                        <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{localize this.label}}</option>
                        {{/each}}
                    </select>
                    <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
                       data-tooltip="{{localize 'RSR.editor.visibilityHint'}}"></i>
                </span>
            </div>
            <div class="rsr-form-row">
                <label for="rsr-f-hideValues">{{localize "RSR.visibility.hideValues"}}</label>
                <span class="rsr-form-check">
                    <input type="checkbox" id="rsr-f-hideValues" name="hideValues"{{#if editor.hideValues}} checked{{/if}}>
                    <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
                       data-tooltip="{{localize 'RSR.editor.hideValuesHint'}}"></i>
                </span>
            </div>

            {{!-- The placeholder is the real default, localized, so an empty box
                  reads as what the table would actually see rather than as
                  nothing. --}}
            <div class="rsr-form-row">
                <label for="rsr-f-maskLabel">{{localize "RSR.editor.maskLabel"}}</label>
                <span class="rsr-form-inline">
                    <input type="text" id="rsr-f-maskLabel" name="maskLabel"
                           value="{{editor.maskLabel}}"
                           placeholder="{{localize editor.maskDefault}}">
                    <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
                       data-tooltip="{{localize 'RSR.editor.maskLabelHint'}}"></i>
                </span>
            </div>

            {{!-- Only where there is a reading for it to stand in for. --}}
            {{#if editor.hasMaskNote}}
            <div class="rsr-form-row is-stacked">
                <label for="rsr-f-maskNote">{{localize "RSR.editor.maskNote"}}</label>
                <span class="rsr-form-inline">
                    <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
                       data-tooltip="{{localize editor.maskNoteHint}}"></i>
                </span>
                <textarea id="rsr-f-maskNote" name="maskNote" rows="2"
                          placeholder="{{localize 'RSR.editor.maskNotePlaceholder'}}">{{editor.maskNote}}</textarea>
            </div>
            {{/if}}
        </section>
        {{/if}}
    </form>

    {{!-- The Save bar. A count rather than a dot: "3 unsaved changes" answers
          whether you touched more than you meant to. --}}
    <footer class="rsr-editor-bar{{#if editor.isDirty}} is-dirty{{/if}}">
        {{!-- Deleting lives here, at the far end of the bar from Save and only
              once the row actually exists. It was on the Thread row itself,
              which put a bin beside every Thread on a screen a GM spends their
              time reading rather than editing. One level in, next to the other
              things you can do to this one row, is where it belongs — and the
              confirm still asks. --}}
        {{#if editor.canDelete}}
        <button type="button" class="rsr-btn rsr-btn-danger" data-action="{{editor.deleteAction}}"
                data-thread-id="{{editor.id}}"
                data-tooltip="{{localize editor.deleteHint}}">
            <i class="fa-solid fa-trash" inert></i>
            <span>{{localize editor.deleteLabel}}</span>
        </button>
        {{/if}}

        {{#if editor.isDirty}}
        <span class="rsr-editor-status">
            <i class="fa-solid fa-circle" inert></i>
            {{localize "RSR.editor.unsaved" count=editor.dirtyCount}}
        </span>
        {{else}}
        <span class="rsr-editor-status is-clean">{{localize "RSR.editor.noChanges"}}</span>
        {{/if}}

        <button type="button" class="rsr-btn" data-action="revertEdit"
                {{#unless editor.isDirty}}disabled{{/unless}}
                data-tooltip="{{localize 'RSR.editor.revertHint'}}">
            <i class="fa-solid fa-rotate-left" inert></i>
            <span>{{localize "RSR.editor.revert"}}</span>
        </button>
        <button type="button" class="rsr-btn rsr-btn-primary" data-action="saveEdit">
            <i class="fa-solid fa-floppy-disk" inert></i>
            <span>{{localize "RSR.editor.save"}}</span>
        </button>
    </footer>
</div>
