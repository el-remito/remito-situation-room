{{!--
    The board shell.

    Segments come from context.segments, which already excludes Cockpit for players
    and already carries `active`. The comparison happens in _prepareContext rather
    than here because a branch resolved in the markup needs both sides of it in
    the context, and half of what this window renders is data a player must never
    be sent.

    `isGM` in this file is the PROJECTED viewer: a GM previewing the table's board
    is false. `canPreview` is the real one, and it is the only thing that is.

    Partials are referenced by full path, which is how loadTemplates registers them.
--}}
<div class="rsr-board-root">

    <nav class="rsr-segments" aria-label="{{localize 'RSR.board.viewSwitcher'}}">
        {{#each segments}}
        <button type="button"
                class="rsr-segment{{#if this.active}} is-active{{/if}}"
                data-action="selectView"
                data-view="{{this.id}}"
                {{#if this.active}}aria-current="page"{{/if}}>
            <i class="{{this.icon}}" inert></i>
            <span>{{localize this.label}}</span>
        </button>
        {{/each}}

        {{#if isGM}}
        {{!-- One string, not a label and a number: whether this campaign counts
              in runs of Cycles is a Settings question, and the badge should not
              be assembling the answer out of parts. --}}
        <span class="rsr-turn-badge" data-tooltip-class="rsr-tip" data-tooltip="{{localize 'RSR.turn.tooltip'}}">
            {{turnReading}}
        </span>
        {{/if}}

        {{!-- Rendered from canPreview, which is the REAL GM, not the projected
              one: this is the only way back out of the preview it turns on. --}}
        {{#if canPreview}}
        <button type="button"
                class="rsr-preview-btn{{#if isPreview}} is-on{{/if}}"
                data-action="togglePreview"
                data-tooltip="{{localize 'RSR.preview.hint'}}"
                aria-pressed="{{#if isPreview}}true{{else}}false{{/if}}">
            <i class="fa-regular fa-eye" inert></i>
            <span>{{localize "RSR.preview.label"}}</span>
        </button>
        {{/if}}

        {{!-- Also the REAL GM. Disabled rather than hidden when nobody is
              connected: a control that vanishes reads as a control that broke. --}}
        {{#if showPlayers}}
        <button type="button"
                class="rsr-show-btn"
                data-action="showPlayers"
                {{#unless showPlayers.can}}disabled{{/unless}}
                data-tooltip-class="rsr-tip"
                data-tooltip="{{localize showPlayers.hint}}">
            <i class="fa-solid fa-tv" inert></i>
            <span>{{localize "RSR.show.label"}}</span>
        </button>
        {{/if}}
    </nav>

    {{!-- Loud on purpose. Everything below this line is a lie of omission being
          told correctly, and a GM who forgets they are inside it will conclude
          their own board has lost half its rows. --}}
    {{#if isPreview}}
    <div class="rsr-preview-bar" role="status">
        <i class="fa-solid fa-eye-low-vision" inert></i>
        <span class="rsr-preview-said">{{localize "RSR.preview.banner"}}</span>
        <button type="button" class="rsr-mini" data-action="togglePreview">
            {{localize "RSR.preview.exit"}}
        </button>
    </div>
    {{/if}}

    <section class="rsr-body">

        {{!-- Edit mode renders over everything: when it is open the view builders
              never run, so there is nothing underneath to render anyway. --}}
        {{#if isEditing}}
        {{> "modules/remito-situation-room/templates/partials/editor.hbs"}}
        {{/if}}

        {{#if isSituation}}

            {{!-- Drilled into one Plot --}}
            {{#if openPlot}}
            <div class="rsr-view rsr-view-plot">
                {{!-- Reading order, top to bottom: what this is, what it is
                      about, where it stands, what standing there looks like, and
                      who is standing in it.

                      The first three STAY, pinned to the top of the scroller.
                      Nine Threads is more than a screenful, and a GM three
                      Threads down had lost the one thing every one of those
                      rows is about — which Plot this is and how far it has
                      swung. Everything from Involved Forces down scrolls
                      normally: the roster is reference, not a running total. --}}
                <div class="rsr-plot-sticky">
                <header class="rsr-plot-detail-head">
                    {{!-- The way out of this Plot, ON the header line rather
                          than above it. Standing outside the shelf it scrolled
                          up underneath and was sliced in half by the slab that
                          covers the scroller's top padding, and a control you
                          cannot reach is worse than one that is not there.
                          Inside the thing that pins itself it cannot be covered
                          by it, and a breadcrumb before the name is what it was
                          always doing. --}}
                    <button type="button" class="rsr-crumb" data-action="closePlot">
                        <i class="fa-solid fa-chevron-left" inert></i>
                        <span>{{localize "RSR.board.allPlots"}}</span>
                    </button>
                    <h2 class="rsr-plot-title">{{openPlot.name}}</h2>
                    {{#unless openPlot.isActive}}
                    <span class="rsr-chip rsr-chip-quiet">{{localize openPlot.lifecycleLabel}}</span>
                    {{/unless}}
                    {{#if openPlot.isExample}}
                    <span class="rsr-chip rsr-chip-example">{{localize "RSR.help.exampleTag"}}</span>
                    {{/if}}

                    {{!-- This Plot's own clock, and the only button that moves
                          it. Both GM-only by way of the context: a Plot on the
                          world's clock has neither field, so there is nothing
                          here to hide from anyone. --}}
                    {{#if openPlot.offTheClock}}
                    <span class="rsr-chip rsr-chip-quiet" data-tooltip="{{localize 'RSR.turn.noneHint'}}">
                        {{localize "RSR.turn.offLabel"}}
                    </span>
                    {{/if}}
                    {{#if openPlot.onOwnClock}}
                    <span class="rsr-plot-clock">
                        <span class="rsr-chip rsr-chip-clock" data-tooltip="{{localize 'RSR.turn.isolatedHint'}}">
                            <i class="fa-solid fa-hourglass-half" inert></i>
                            {{openPlot.plotTurnLabel}} {{openPlot.plotTurn}}
                        </span>
                        <button type="button" class="rsr-mini" data-action="advancePlotTurn"
                                data-plot-id="{{openPlot.id}}"
                                data-tooltip="{{localize 'RSR.turn.plotAdvanceHint'}}">
                            <i class="fa-solid fa-hourglass-end" inert></i>
                            <span>{{localize "RSR.turn.plotAdvance"}}</span>
                        </button>
                    </span>
                    {{/if}}

                    {{!-- Outside the block above rather than inside it: a Plot
                          the GM has since put back on the world's clock still
                          has a cycle of its own to take back. --}}
                    {{#if openPlot.revert}}
                    <button type="button" class="rsr-mini rsr-mini-undo" data-action="revertTurn"
                            data-plot-id="{{openPlot.id}}"
                            {{#unless openPlot.revert.can}}disabled{{/unless}}
                            data-tooltip-class="rsr-tip"
                            data-tooltip="{{localize openPlot.revert.hint}}">
                        <i class="fa-solid fa-rotate-left" inert></i>
                        <span>{{localize "RSR.turn.revertLabel"}}</span>
                    </button>
                    {{/if}}

                    {{!-- The pen, again. It is on the card in the list and it was
                          nowhere in here, so changing a Plot meant leaving the
                          Plot — and every reason to change one is a reason you
                          are standing inside it. Pinned right rather than set
                          beside the name, which the chips already share. --}}
                    {{#if @root.isGM}}
                    <span class="rsr-plot-detail-tools">
                        <button type="button" class="rsr-icon-btn" data-action="editPlot"
                                data-plot-id="{{openPlot.id}}"
                                data-tooltip="{{localize 'RSR.editor.editPlot'}}">
                            <i class="fa-solid fa-pen" inert></i>
                        </button>
                    </span>
                    {{/if}}
                </header>

                {{#if openPlot.description}}
                <p class="rsr-plot-desc">{{openPlot.description}}</p>
                {{/if}}

                {{!-- The State line. The reading sits WITH the Phase it belongs
                      to: "Critical, 58 of 100" is one fact, and it was previously
                      split across the width of the window. --}}
                <section class="rsr-state-block">
                    <div class="rsr-state-line">
                        <span class="rsr-state-label">{{localize "RSR.plot.state"}}</span>
                        {{#if openPlot.phaseLabel}}
                        <span class="rsr-chip rsr-tone-{{openPlot.phaseTone}}">{{openPlot.phaseLabel}}</span>
                        {{/if}}
                        {{#if openPlot.showState}}
                        <span class="rsr-state-count rsr-tone-{{openPlot.phaseTone}}">
                            {{openPlot.state}}<span class="rsr-of">/{{openPlot.stateMax}}</span>
                        </span>
                        {{/if}}
                        {{#if openPlot.showBar}}
                        <div class="rsr-state-bar rsr-state-bar-lg" role="img"
                             aria-label="{{localize 'RSR.plot.state'}}{{#if openPlot.showState}} {{openPlot.state}} / {{openPlot.stateMax}}{{/if}}">
                            <div class="rsr-state-fill rsr-tone-{{openPlot.phaseTone}}"
                                 style="width: {{openPlot.percent}}%"></div>
                        </div>
                        {{/if}}
                    </div>

                    {{!-- What the table has heard, where the reading would be. --}}
                    {{#unless openPlot.showBar}}
                    <p class="rsr-mask-note">{{openPlot.maskNote}}</p>
                    {{/unless}}

                    {{!-- What this Phase looks like from the table. Only ever the
                          CURRENT one: the ladder never leaves _prepareContext. --}}
                    {{#if openPlot.phaseDescription}}
                    <p class="rsr-phase-desc">{{openPlot.phaseDescription}}</p>
                    {{/if}}
                </section>
                </div>

                {{!-- The roster, in whatever groupings the GM arranged it in.
                      Cosmetic by design — nothing reads a grouping — but which
                      side a Force is on is the first question anyone asks. --}}
                {{#if openPlot.groups.length}}
                <section class="rsr-involved">
                    <h4 class="rsr-involved-title">{{localize "RSR.plot.involved"}}</h4>
                    {{#each openPlot.groups}}
                    <div class="rsr-group">
                        {{#if this.hasLabel}}
                        <span class="rsr-group-label">{{this.label}}</span>
                        {{else}}
                            {{#if this.isRemainder}}
                            <span class="rsr-group-label is-quiet">{{localize "RSR.plot.ungrouped"}}</span>
                            {{/if}}
                        {{/if}}
                        <ul class="rsr-force-chips">
                            {{#each this.forces}}
                            <li class="rsr-force-chip{{#if this.masked}} is-masked{{/if}}">{{this.name}}</li>
                            {{/each}}
                        </ul>
                    </div>
                    {{/each}}
                </section>
                {{/if}}

                {{#if openPlot.gmNotes}}
                <p class="rsr-gm-notes"><i class="fa-solid fa-eye-slash" inert></i> {{openPlot.gmNotes}}</p>
                {{/if}}

                <header class="rsr-section-head">
                    <h3>
                        {{localize "RSR.thread.plural"}}
                        <span class="rsr-count">{{openPlot.threadCount}}</span>
                    </h3>
                    <span class="rsr-head-tools">
                        {{!-- Two readings of the same Threads. The list is what
                              is happening; Requirements is what is waiting on
                              what, which the list can only ever say one row at a
                              time. Everyone gets both — a table that can see a
                              Thread can see what it is waiting for. --}}
                        <span class="rsr-tabs" role="tablist">
                            <button type="button" role="tab" class="rsr-tab{{#if openPlot.showThreads}} is-on{{/if}}"
                                    aria-selected="{{#if openPlot.showThreads}}true{{else}}false{{/if}}"
                                    data-action="setPlotTab" data-tab="threads">
                                <i class="fa-solid fa-list" inert></i>
                                <span>{{localize "RSR.thread.plural"}}</span>
                            </button>
                            <button type="button" role="tab" class="rsr-tab{{#if openPlot.showGraph}} is-on{{/if}}"
                                    aria-selected="{{#if openPlot.showGraph}}true{{else}}false{{/if}}"
                                    data-action="setPlotTab" data-tab="graph">
                                <i class="fa-solid fa-diagram-project" inert></i>
                                <span>{{localize "RSR.graph.tab"}}</span>
                            </button>
                        </span>
                        {{#if isGM}}
                        <button type="button" class="rsr-btn" data-action="createThread">
                            <i class="fa-solid fa-plus" inert></i>
                            <span>{{localize "RSR.editor.newThread"}}</span>
                        </button>
                        {{/if}}
                    </span>
                </header>

                {{#if openPlot.showThreads}}

                {{!-- Only once there is more than one row to tell apart. On a
                      Plot with a single Thread the box is furniture. --}}
                {{#if openPlot.hasManyThreads}}
                {{> "modules/remito-situation-room/templates/partials/search-bar.hbs" scope="threads"
                    placeholder="RSR.search.threadsPlaceholder"}}
                {{/if}}

                {{!-- The hand. Drag one of these onto a Thread below to commit
                      it; drag a committed Asset back onto its Force to release. --}}
                {{#if openPlot.tray.length}}
                <div class="rsr-tray">
                    {{#each openPlot.tray}}
                    <div class="rsr-tray-force" data-force-id="{{this.id}}">
                        <span class="rsr-tray-name">
                            <i class="{{this.icon}}" inert></i> {{this.name}}
                        </span>
                        {{#each this.assets}}
                        <span class="rsr-tray-asset{{#if this.isHiddenFromPlayers}} is-veiled{{/if}}"
                              data-asset-id="{{this.id}}"
                              data-tooltip="{{localize 'RSR.asset.dragHint'}}">
                            <i class="fa-solid fa-grip-vertical" inert></i>
                            {{this.name}}
                            {{!-- Recovering and Destroyed never reach the tray at
                                  all: uncommittedAssets drops what is out of play,
                                  so an Asset here is Ready, Damaged or Inactive. --}}
                            {{#unless this.isReady}}
                            <span class="rsr-condition is-{{this.condition}}">{{localize this.conditionLabel}}</span>
                            {{/unless}}
                            {{#if this.hasModifier}}
                            <em>{{localize this.modifierLabel}}
                                {{#if this.modifierOff}}<s>{{this.modifierValue}}</s> {{this.modifierWorth}}
                                {{else}}{{this.modifierValue}}{{/if}}</em>
                            {{/if}}
                        </span>
                        {{/each}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{#if openPlot.threads.length}}
                <ul class="rsr-threads" data-search-list="threads">
                    {{#each openPlot.threads}}
                    {{> "modules/remito-situation-room/templates/partials/node-row.hbs"}}
                    {{/each}}
                </ul>
                {{!-- Every row is still in the list, hidden. Without this the
                      board reads as one that has lost its Threads. --}}
                <p class="rsr-empty rsr-search-empty" data-search-empty="threads" hidden>
                    {{localize "RSR.search.none"}}
                </p>
                {{else}}
                <p class="rsr-empty">{{localize "RSR.board.noThreads"}}</p>
                {{/if}}

                {{else}}
                {{> "modules/remito-situation-room/templates/partials/graph.hbs"}}
                {{/if}}
            </div>

            {{!-- The Plot list --}}
            {{else}}
            {{!-- Two columns of Plots and a chronicle in the third. The grid
                  is capped at two deliberately: a card that keeps narrowing to fit
                  another column stops being readable, and what belongs in the space
                  that would have been the third column is what has been happening. --}}
            <div class="rsr-view rsr-view-situation">
                <div class="rsr-situation-split">
                    <div class="rsr-situation-main">
                        {{#if isGM}}
                        {{!-- The world's clock is pressed from here, beside the
                              Plots it moves. It used to sit in the Cockpit, one
                              segment away from the isolated Plot buttons that do
                              the same job at a smaller scale — two clocks on two
                              screens, which is how a GM forgets one exists. It
                              is named for the clock it moves, so it reads as the
                              GLOBAL one next to a Plot keeping its own, and it
                              follows the GM's own word for that clock. --}}
                        <header class="rsr-section-head">
                            <h3>{{localize "RSR.plot.plural"}}</h3>
                            <span class="rsr-head-tools">
                                <button type="button" class="rsr-btn rsr-btn-primary"
                                        data-action="advanceTurn" data-tooltip-class="rsr-tip"
                                        data-tooltip="{{localize 'RSR.turn.tooltip'}}">
                                    <i class="fa-solid fa-hourglass-end" inert></i>
                                    <span>{{localize "RSR.turn.advanceNamed" label=turnLabel}}</span>
                                </button>
                                {{!-- Drawn only when the last cycle was the
                                      WORLD's, and drawn DISABLED when something
                                      has been recorded since — with the reason
                                      on it. A control that vanishes is worse
                                      than one that will not work: this is
                                      exactly what a GM who pressed the button
                                      by accident comes looking for. --}}
                                {{#if turnRevert}}
                                <button type="button" class="rsr-btn rsr-btn-undo"
                                        data-action="revertTurn"
                                        {{#unless turnRevert.can}}disabled{{/unless}}
                                        data-tooltip-class="rsr-tip"
                                        data-tooltip="{{localize turnRevert.hint}}">
                                    <i class="fa-solid fa-rotate-left" inert></i>
                                    <span>{{localize "RSR.turn.revertLabel"}}</span>
                                </button>
                                {{/if}}
                                {{!-- A page turns because something ended, not
                                      because four Cycles elapsed, so where a run
                                      begins is a decision and this is where it
                                      is taken: beside the button that produced
                                      the Cycle it opens on. Drawn disabled, with
                                      the reason, when that Cycle is already
                                      marked — the same courtesy the undo gets. --}}
                                {{#if turnMark}}
                                <button type="button" class="rsr-btn rsr-btn-mark"
                                        data-action="beginChapter"
                                        {{#unless turnMark.can}}disabled{{/unless}}
                                        data-tooltip-class="rsr-tip"
                                        data-tooltip="{{localize turnMark.hint}}">
                                    <i class="fa-solid fa-bookmark" inert></i>
                                    <span>{{localize "RSR.turn.segmentBegin" segment=turnMark.word}}</span>
                                </button>
                                {{/if}}
                                <button type="button" class="rsr-btn" data-action="createPlot">
                                    <i class="fa-solid fa-plus" inert></i>
                                    <span>{{localize "RSR.editor.newPlot"}}</span>
                                </button>
                            </span>
                        </header>
                        {{/if}}

                        {{!-- Outside the GM header above, because a player's
                              board has no header and the same eleven Plots.
                              A card matches on its own name, on any Thread the
                              reader may see, and on any Asset committed to it —
                              so "granary" finds the siege that holds it. --}}
                        {{#if hasManyPlots}}
                        {{> "modules/remito-situation-room/templates/partials/search-bar.hbs" scope="plots"
                            placeholder="RSR.search.plotsPlaceholder"}}
                        {{/if}}

                        {{#if plots.length}}
                        <div class="rsr-plot-grid" data-search-list="plots">
                            {{#each plots}}
                            {{> "modules/remito-situation-room/templates/partials/plot-card.hbs"}}
                            {{/each}}
                        </div>
                        <p class="rsr-empty rsr-search-empty" data-search-empty="plots" hidden>
                            {{localize "RSR.search.none"}}
                        </p>
                        {{else}}
                        <p class="rsr-empty">{{localize "RSR.board.noPlots"}}</p>
                        {{/if}}
                    </div>

                    {{> "modules/remito-situation-room/templates/partials/log.hbs"}}
                </div>
            </div>
            {{/if}}

        {{/if}}

        {{!-- The Cockpit. GM-only, and the context proves it: `cockpit` is null
              for anyone else, so there is nothing here to hide. --}}
        {{#if cockpit}}
        <div class="rsr-view rsr-view-cockpit">

            <header class="rsr-section-head">
                <h3>{{localize "RSR.force.plural"}}</h3>
                {{!-- The Next Cycle button used to stand here. It moved to the
                      Plot list, where the isolated Plots keep their own buttons;
                      what stays behind is the reading, because WHO gets paid is
                      a Force question and this is the Forces screen. --}}
                <button type="button" class="rsr-btn" data-action="createForce">
                    <i class="fa-solid fa-plus" inert></i>
                    <span>{{localize "RSR.editor.newForce"}}</span>
                </button>
            </header>

            <p class="rsr-turn-line">
                {{localize "RSR.turn.standing" reading=cockpit.reading count=cockpit.payingCount}}
            </p>

            {{!-- The footnote. Every Force and what the next cycle does to it,
                  including the ones it does nothing to — those are the rows a GM
                  is looking for when a cycle seems not to have worked. --}}
            {{#if cockpit.roster.length}}
            <details class="rsr-roster" data-sync="cycle-roster" open>
                <summary>{{localize "RSR.turn.rosterTitle"}}</summary>
                <ul class="rsr-bill">
                    {{#each cockpit.roster}}
                    <li class="{{#unless this.willBePaid}}is-idle{{/unless}}">
                        <span class="rsr-bill-name">{{this.name}}</span>
                        <span class="rsr-bill-delta">{{#if this.willBePaid}}{{numberFormat this.paid sign=true}}{{else}}&mdash;{{/if}}</span>
                        <span class="rsr-bill-total">{{this.from}} &rarr; {{this.to}}</span>
                        <span class="rsr-bill-why">{{#if this.reason}}{{localize this.reason}}{{/if}}</span>
                    </li>
                    {{/each}}
                </ul>
            </details>
            {{/if}}

            {{#if cockpit.forces.length}}
            <div class="rsr-force-grid">
                {{#each cockpit.forces}}
                {{> "modules/remito-situation-room/templates/partials/force-panel.hbs"}}
                {{/each}}
            </div>
            {{else}}
            <p class="rsr-empty">{{localize "RSR.force.none"}}</p>
            {{/if}}
        </div>
        {{/if}}

        {{#if settings}}
        <div class="rsr-view rsr-view-settings">
            <header class="rsr-section-head">
                <h3>{{localize "RSR.settings.title"}}</h3>
            </header>
            {{> "modules/remito-situation-room/templates/partials/settings.hbs"}}
        </div>
        {{/if}}

        {{#if isHelp}}
        <div class="rsr-view rsr-view-help">
            {{> "modules/remito-situation-room/templates/partials/help.hbs"}}
        </div>
        {{/if}}

    </section>
</div>
