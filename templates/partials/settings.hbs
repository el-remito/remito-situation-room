{{!--
    The Settings segment: the numbers a GM sets once for a campaign.

    A plain <form> inside the board rather than a dialog, because these are read
    together and edited rarely — a dialog per number would be worse. The Save
    handler reads target.closest('form'), so the form element itself matters.

    Everything here seeds a NEW row except The Cycle section, which is marked as
    the exception where it stands. Changing a default never reaches back and
    rewrites a Plot, Thread, Force or Asset that already exists, which is what
    makes this tab safe to touch mid-campaign.

    Every field carries a ⓘ rather than a paragraph under it. Twelve fields with a
    paragraph each is a wall nobody reads twice, and these are numbers a GM sets
    once: the explanation should be there the first time and out of the way after.
    Each badge names rsr-tip, which is what gives the tooltip documentation's
    shape instead of a 320px centred block.
--}}
<form class="rsr-settings">

    <section class="rsr-settings-group">
        <h4>{{localize "RSR.settings.forcesTitle"}}</h4>
        <p class="rsr-settings-note">{{localize "RSR.settings.forcesNote"}}</p>

        <div class="rsr-settings-row">
            <label for="rsr-forceResources">{{localize "RSR.settings.forceResources"}}</label>
            <span class="rsr-settings-controls">
                <input type="number" id="rsr-forceResources" name="forceResources"
                       value="{{settings.constants.forceResources}}">
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.forceResourcesHint'}}"></i>
        </div>

        <div class="rsr-settings-row">
            <label for="rsr-forceIncome">{{localize "RSR.settings.forceIncome"}}</label>
            <span class="rsr-settings-controls">
                <input type="number" id="rsr-forceIncome" name="forceIncome"
                       value="{{settings.constants.forceIncome}}">
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.forceIncomeHint'}}"></i>
        </div>

        <div class="rsr-settings-row">
            <label for="rsr-forceIcon">{{localize "RSR.settings.forceIcon"}}</label>
            <span class="rsr-settings-controls">
                <input type="text" id="rsr-forceIcon" name="forceIcon"
                       value="{{settings.constants.forceIcon}}"
                       placeholder="{{settings.defaults.forceIcon}}">
                {{!-- A live look at whatever class was typed, so a typo shows
                      itself before the GM saves. --}}
                <i class="{{settings.constants.forceIcon}} rsr-icon-preview" inert></i>
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.forceIconHint'}}"></i>
        </div>

        <div class="rsr-settings-row">
            <label for="rsr-assetCost">{{localize "RSR.settings.assetCost"}}</label>
            <span class="rsr-settings-controls">
                <input type="number" id="rsr-assetCost" name="assetCost" min="0"
                       value="{{settings.constants.assetCost}}">
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.assetCostHint'}}"></i>
        </div>
    </section>

    <section class="rsr-settings-group">
        <h4>{{localize "RSR.settings.plotsTitle"}}</h4>
        <p class="rsr-settings-note">{{localize "RSR.settings.plotsNote"}}</p>

        <div class="rsr-settings-row">
            <label for="rsr-threadThreshold">{{localize "RSR.settings.threadThreshold"}}</label>
            <span class="rsr-settings-controls">
                <input type="number" id="rsr-threadThreshold" name="threadThreshold" min="1"
                       value="{{settings.constants.threadThreshold}}">
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.threadThresholdHint'}}"></i>
        </div>

        <div class="rsr-settings-row">
            <label for="rsr-clockSegments">{{localize "RSR.settings.clockSegments"}}</label>
            <span class="rsr-settings-controls">
                <input type="number" id="rsr-clockSegments" name="clockSegments" min="1"
                       value="{{settings.constants.clockSegments}}">
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.clockSegmentsHint'}}"></i>
        </div>

        <div class="rsr-settings-row">
            <label for="rsr-stateMin">{{localize "RSR.settings.stateRange"}}</label>
            <span class="rsr-settings-controls">
                <input type="number" id="rsr-stateMin" name="stateMin" value="{{settings.constants.stateMin}}">
                <input type="number" name="stateMax" value="{{settings.constants.stateMax}}">
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.stateRangeHint'}}"></i>
        </div>
    </section>

    {{!-- The one section on this tab that seeds NOTHING. Everything else here is
          copied into the next row created and never reaches an existing one;
          these rename a clock the whole board is already counting on, and say
          where its runs began — both of which change how something already on
          the board is READ, which is why they stand apart from the sections
          that promise otherwise. --}}
    <section class="rsr-settings-group">
        <h4>{{localize "RSR.settings.cycleTitle"}}</h4>
        <p class="rsr-settings-note">{{localize "RSR.settings.cycleNote"}}</p>

        <div class="rsr-settings-row">
            <label for="rsr-turnLabel">{{localize "RSR.settings.turnLabel"}}</label>
            <span class="rsr-settings-controls">
                <input type="text" id="rsr-turnLabel" name="turnLabel"
                       value="{{settings.constants.turnLabel}}"
                       placeholder="{{localize 'RSR.turn.globalLabel'}}">
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.turnLabelHint'}}"></i>
        </div>

        {{!-- A campaign is rarely one undifferentiated column of Cycles. This
              word is what the larger unit is called, and, like the word above,
              it changes how something already on the board is READ rather than
              seeding anything new. --}}
        <div class="rsr-settings-row">
            <label for="rsr-chapterLabel">{{localize "RSR.settings.segmentLabel"}}</label>
            <span class="rsr-settings-controls">
                <input type="text" id="rsr-chapterLabel" name="chapterLabel"
                       value="{{settings.constants.chapterLabel}}"
                       placeholder="{{localize 'RSR.turn.segmentLabel'}}">
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.segmentLabelHint'}}"></i>
        </div>

        {{!-- The third word this section owns, and the only one about a Thread
              rather than about the clock — but it belongs here, because it is a
              word for something the CYCLE does, and because this is where a GM
              already comes looking for the words their campaign uses. Any one
              Thread may still say otherwise; this is the word for most of
              them. --}}
        <div class="rsr-settings-row">
            <label for="rsr-expiryLabel">{{localize "RSR.settings.expiryLabel"}}</label>
            <span class="rsr-settings-controls">
                <input type="text" id="rsr-expiryLabel" name="expiryLabel"
                       value="{{settings.constants.expiryLabel}}"
                       placeholder="{{localize 'RSR.thread.expired'}}">
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.expiryLabelHint'}}"></i>
        </div>

        {{!-- And this is WHERE each one began: one row per mark, each naming the
              Cycle it opened on. A list rather than a length, because a chapter
              ends when something ends and not when a number divides — and because
              a row can carry a name, which an ordinal worked out by arithmetic
              never could.

              Rows are added and removed in the DOM and harvested on Save, so
              adding a second one cannot lose what was half-typed into the first.
              The hidden row at the end is the one every new row is cloned from. --}}
        <div class="rsr-settings-row rsr-settings-row-list">
            <label>{{localize "RSR.settings.segments"}}</label>
            <span class="rsr-settings-controls rsr-settings-stack">
                {{!-- Two column heads, each with its own badge, rather than a
                      badge on every row: the rows are N instances of the same
                      two questions, and the answers do not change with the row.
                      It also means a row added by pressing the button below
                      arrives under headings that were already on screen, rather
                      than as two blank boxes nobody introduced. --}}
                <span class="rsr-chapter-head">
                    <span>
                        {{localize "RSR.settings.segmentAt"}}
                        <i class="fa-regular fa-circle-question rsr-info"
                           data-tooltip-class="rsr-tip"
                           data-tooltip="{{localize 'RSR.settings.segmentAtHint'}}"></i>
                    </span>
                    <span>
                        {{localize "RSR.settings.segmentNamed"}}
                        <i class="fa-regular fa-circle-question rsr-info"
                           data-tooltip-class="rsr-tip"
                           data-tooltip="{{localize 'RSR.settings.segmentNamedHint'}}"></i>
                    </span>
                    <span></span>
                </span>

                <span class="rsr-chapter-list">
                    {{#each settings.chapters}}
                    <span class="rsr-chapter-row">
                        <input type="number" name="chapterAt" min="1" value="{{this.at}}"
                               placeholder="{{localize 'RSR.settings.segmentAtPlaceholder'}}"
                               aria-label="{{localize 'RSR.settings.segmentAt'}}">
                        {{!-- The placeholder is what this run is CALLED with the
                              box left empty, which is the most useful thing the
                              grey text could say: clear the name and you can
                              read what you get back. --}}
                        <input type="text" name="chapterName" value="{{this.name}}"
                               placeholder="{{this.label}}"
                               aria-label="{{localize 'RSR.settings.segmentNamed'}}">
                        <button type="button" class="rsr-mini rsr-danger"
                                data-action="removeChapter"
                                data-tooltip="{{localize 'RSR.settings.segmentRemove'}}">
                            <i class="fa-solid fa-xmark" inert></i>
                        </button>
                    </span>
                    {{/each}}

                    {{!-- A new row cannot know its own number until a Cycle is
                          typed into it, so its name box says what happens when
                          nothing is typed instead of naming the run. --}}
                    <span class="rsr-chapter-row" data-chapter-proto hidden>
                        <input type="number" name="chapterAt" min="1" value=""
                               placeholder="{{localize 'RSR.settings.segmentAtPlaceholder'}}"
                               aria-label="{{localize 'RSR.settings.segmentAt'}}">
                        <input type="text" name="chapterName" value=""
                               placeholder="{{localize 'RSR.settings.segmentNamedPlaceholder'}}"
                               aria-label="{{localize 'RSR.settings.segmentNamed'}}">
                        <button type="button" class="rsr-mini rsr-danger"
                                data-action="removeChapter"
                                data-tooltip="{{localize 'RSR.settings.segmentRemove'}}">
                            <i class="fa-solid fa-xmark" inert></i>
                        </button>
                    </span>
                </span>

                <span class="rsr-chapter-foot">
                    <button type="button" class="rsr-mini" data-action="addChapter">
                        <i class="fa-solid fa-plus" inert></i>
                        <span>{{localize "RSR.settings.segmentAdd"}}</span>
                    </button>
                    {{!-- What the board says right now, the way the icon field
                          shows the glyph it was given: this list changes a
                          reading and nothing else, so the reading is the
                          preview. It catches up on Save. --}}
                    <span class="rsr-settings-said">{{settings.reading}}</span>
                </span>
            </span>
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.settings.segmentsHint'}}"></i>
        </div>
    </section>

    <section class="rsr-settings-group">
        {{!-- One badge for the four rows, because they are four instances of one
              question and the answer is the same three words each time. It is the
              same hint the editors' Visibility field carries. --}}
        <h4>
            {{localize "RSR.settings.tableTitle"}}
            <i class="fa-regular fa-circle-question rsr-info" data-tooltip-class="rsr-tip"
               data-tooltip="{{localize 'RSR.editor.visibilityHint'}}"></i>
        </h4>

        <p class="rsr-settings-note">{{localize "RSR.settings.defaultVisibility.hint"}}</p>

        {{!-- One default per KIND of row. A GM usually wants the sides named from
              the start and the Threads they are running kept quiet, and a single
              setting for all four made them correct every new Force by hand. --}}
        {{#each settings.visibilityKinds}}
        <div class="rsr-settings-row">
            <label for="rsr-visibility-{{this.kind}}">{{localize this.label}}</label>
            <span class="rsr-settings-controls">
                <select id="rsr-visibility-{{this.kind}}" name="visibility-{{this.kind}}">
                    {{#each this.options}}
                    <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>
                        {{localize this.label}}
                    </option>
                    {{/each}}
                </select>
            </span>
        </div>
        {{/each}}
    </section>

    {{!-- The condition table is a list, not a number, so it gets its own screen
          rather than a section of this form. The button is here because this is
          where a GM comes looking for the things they set once. --}}
    <section class="rsr-settings-section">
        <h3>{{localize "RSR.asset.conditionsTitle"}}</h3>
        <p class="rsr-form-note">{{localize "RSR.asset.conditionsSettingsNote"}}</p>
        <button type="button" class="rsr-btn" data-action="editConditions">
            <i class="fa-solid fa-heart-crack" inert></i>
            <span>{{localize "RSR.asset.conditionsEdit"}}</span>
        </button>
    </section>

    <footer class="rsr-settings-foot">
        <button type="button" class="rsr-btn rsr-btn-primary" data-action="saveSettings">
            <i class="fa-solid fa-floppy-disk" inert></i>
            <span>{{localize "RSR.settings.save"}}</span>
        </button>
        <button type="button" class="rsr-btn" data-action="resetSettings">
            <i class="fa-solid fa-rotate-left" inert></i>
            <span>{{localize "RSR.settings.reset"}}</span>
        </button>
    </footer>
</form>
