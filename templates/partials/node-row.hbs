{{!--
    One Thread row. ("node" in code, "Thread" to the reader — the split lives in
    lang/en.json and nowhere else.)

    The mode decides the bar shape, and that branch was already resolved in
    _prepareContext: exactly one of isContested / isClock / isPool is true, or the
    row is concluded. A masked row is always the plain pool bar and never carries
    a mode chip — pips are a clock and a column of contenders is a contest, so the
    shape names the Thread's nature as loudly as the chip did.

    There is ONE control for moving this Thread, whatever its mode, and it opens a
    dialog. The row used to carry a strip of +1 / +3 / −1 buttons per Force and a
    second strip of purses beneath it, and none of it said the thing a GM needed to
    know: whether pressing a button was going to cost anybody anything. That
    question now gets asked out loud, once, in a place with room to answer it.
--}}
<li class="rsr-thread{{#if this.masked}} is-masked{{/if}}{{#if this.isLocked}} is-locked{{/if}}{{#if this.isConcluded}} is-concluded{{/if}}"
    data-thread-id="{{this.id}}"
    data-search="{{this.search}}">

    {{!-- Why the gate is shut. Three gates can shut a Thread and only one of
          them has a name the table may hear: the Threads it is still waiting on,
          and only those the reader may see. The other two are the GM's own
          authoring and are chipped beside the line for the GM alone. A shut row
          with nothing sayable still says it is shut, because a row that has
          quietly lost its controls reads as broken. --}}
    {{#if this.isLocked}}
    <p class="rsr-prereq">
        <i class="fa-solid fa-lock" inert></i>
        {{#if this.prereqNames.length}}
        {{localize "RSR.thread.requires"}} {{#each this.prereqNames}}<em>{{this}}</em>{{#unless @last}}, {{/unless}}{{/each}}
        {{else if this.hasUnseenPrereqs}}
        {{localize "RSR.thread.requiresUnknown"}}
        {{else}}
        {{localize "RSR.gate.shut"}}
        {{/if}}
        {{#each this.shutBy}}
        <span class="rsr-gate-why">{{localize this}}</span>
        {{/each}}
    </p>
    {{/if}}

    {{!-- The GM shut this one and a Phase has since opened it. Without the line
          they would go looking for a switch they still believe is down. --}}
    {{#if this.revealedByPhase}}
    <p class="rsr-prereq rsr-gate-open">
        <i class="fa-solid fa-lock-open" inert></i>
        {{localize "RSR.gate.revealed"}}
    </p>
    {{/if}}

    <header class="rsr-thread-head">
        <span class="rsr-thread-name">{{this.name}}</span>

        <span class="rsr-thread-tags">
            {{#if this.isConcluded}}
            <span class="rsr-chip rsr-chip-done">{{localize this.statusLabel}}</span>
            {{else}}
                {{#if this.isLocked}}
                <span class="rsr-chip rsr-chip-quiet">{{localize this.statusLabel}}</span>
                {{/if}}
                {{!-- Absent under a mask: what KIND of Thread this is is part of
                      what the mask withholds, so there is no key to localize. --}}
                {{#if this.modeLabel}}
                <span class="rsr-chip rsr-chip-mode">{{localize this.modeLabel}}</span>
                {{/if}}
                {{!-- Which way to read the bar under this. It is not decoration:
                      3 of 8 filling and 3 of 8 left are the same two numbers
                      pointing opposite ways, and only watching it move over an
                      evening would tell them apart. Absent under a mask, with
                      the mode chip and the drain itself. --}}
                {{#if this.isDepleting}}
                <span class="rsr-chip rsr-chip-depleting">
                    <i class="fa-solid fa-arrow-down-short-wide" inert></i>
                    {{localize "RSR.thread.depleting"}}
                </span>
                {{/if}}
            {{/if}}

            {{!-- The pen, and nothing beside it. The bin used to stand here and
                  a Plot of nine Threads therefore carried nine of them down the
                  left of the GM's eye — a row of irreversible buttons next to
                  the ordinary ones, on a screen whose whole job is reading. It
                  lives one level in now, at the foot of this Thread's own
                  editor, where deleting is a thing you went somewhere to do. --}}
            {{#if @root.isGM}}
            <button type="button" class="rsr-icon-btn" data-action="editThread" data-thread-id="{{this.id}}"
                    data-tooltip="{{localize 'RSR.editor.editThread'}}">
                <i class="fa-solid fa-pen" inert></i>
            </button>
            {{/if}}
        </span>
    </header>

    {{#if this.description}}
    <p class="rsr-thread-desc">{{this.description}}</p>
    {{/if}}

    {{!-- Concluded: the fiction of what happened. The delta is GM bookkeeping. --}}
    {{#if this.isConcluded}}
    <p class="rsr-outcome">
        {{#if this.concludedBy}}
        <strong>{{this.concludedBy.name}}</strong>
        {{/if}}
        {{this.outcomeNote}}
        {{#if this.outcomeDelta}}
        <span class="rsr-delta">{{localize "RSR.plot.state"}} {{this.outcomeDelta}}</span>
        {{/if}}
    </p>
    {{#if this.canReopen}}
    <div class="rsr-controls">
        <button type="button" class="rsr-mini" data-action="reopenThread" data-thread-id="{{this.id}}"
                data-tooltip="{{localize 'RSR.editor.reopenHint'}}">
            <i class="fa-solid fa-rotate-left" inert></i>
            <span>{{localize "RSR.editor.reopen"}}</span>
        </button>
    </div>
    {{/if}}
    {{/if}}

    {{!-- Contested: one bar per Force, because they do not share a pool. The
          per-Force control only preselects that side in the dialog. --}}
    {{#if this.isContested}}
    <ul class="rsr-contenders">
        {{#each this.contenders}}
        <li class="rsr-contender{{#if this.masked}} is-masked{{/if}}">
            <span class="rsr-contender-name">{{this.name}}</span>
            <span class="rsr-bar">
                <span class="rsr-bar-fill" style="width: {{this.percent}}%"></span>
            </span>
            {{#if this.showValues}}
            <span class="rsr-bar-value">{{this.current}}<span class="rsr-of">/{{this.total}}</span></span>
            {{/if}}
            {{#if this.canPush}}
            <button type="button" class="rsr-mini" data-action="pushThread"
                    name="push-{{../id}}-{{this.id}}"
                    data-thread-id="{{../id}}" data-force-id="{{this.id}}"
                    data-tooltip="{{localize 'RSR.editor.pushForHint'}}">
                <i class="{{../pushIcon}}" inert></i>
            </button>
            {{/if}}
        </li>
        {{/each}}
    </ul>
    {{/if}}

    {{!-- What the table has heard, in place of what it cannot read. Set on a
          masked Thread, and it comes INSTEAD of every bar below rather than
          above them: a bar beside "rumours of a foreigner with a loaded purse"
          would be answering the question the sentence just declined. --}}
    {{#if this.maskNote}}
    <p class="rsr-mask-note">{{this.maskNote}}</p>
    {{/if}}

    {{!-- Clock: discrete segments, so the table can count what is left — which is
      exactly why a viewer who may not read the numbers does not get pips. Four
      filled dots out of six IS the number, and counting them is not a workaround.
      Withheld, the clock falls back to the same plain bar every other Thread
      shows: the shape of the situation is public, its arithmetic is not. --}}
    {{#if this.isClock}}
    <div class="rsr-clock">
        {{#if this.pips}}
        <span class="rsr-pips">
            {{#each this.pips}}<i class="rsr-pip{{#if this.filled}} is-filled{{/if}}"></i>{{/each}}
        </span>
        {{else}}
        <span class="rsr-bar">
            <span class="rsr-bar-fill" style="width: {{this.clock.percent}}%"></span>
        </span>
        {{/if}}
        {{#if this.clock.showValues}}
        <span class="rsr-bar-value">{{this.clock.current}}<span class="rsr-of">/{{this.clock.total}}</span></span>
        {{/if}}
    </div>
    {{/if}}

    {{!-- Invest and fiat both read as one pool against a threshold. --}}
    {{#if this.isPool}}
    <div class="rsr-pool">
        <span class="rsr-bar">
            <span class="rsr-bar-fill" style="width: {{this.pool.percent}}%"></span>
        </span>
        {{#if this.pool.showValues}}
        <span class="rsr-bar-value">{{this.pool.current}}<span class="rsr-of">/{{this.pool.total}}</span></span>
        {{/if}}
    </div>
    {{/if}}

    {{!-- Committed Assets. data-asset-id makes each one draggable: back onto its
          Force panel to release it, onto another Thread to move it. --}}
    {{#if this.committedAssets.length}}
    <p class="rsr-committed">
        {{localize "RSR.asset.committed"}}
        {{#each this.committedAssets}}
        <span class="rsr-asset-chip{{#unless this.isReady}} is-conditioned{{/unless}}"
              data-asset-id="{{this.id}}">
            {{this.name}}
            {{#unless this.isReady}}
            <span class="rsr-condition is-{{this.condition}}">
                {{localize this.conditionLabel}}{{#if this.cyclesLeft}} &middot; {{this.cyclesLeft}}{{/if}}
            </span>
            {{/unless}}
            {{#if this.canRelease}}
            <button type="button" class="rsr-icon-btn rsr-icon-tiny" data-action="releaseAsset"
                    data-asset-id="{{this.id}}" data-tooltip="{{localize 'RSR.asset.releaseHint'}}">
                <i class="fa-solid fa-xmark" inert></i>
            </button>
            {{/if}}
        </span>
        {{/each}}
    </p>
    {{/if}}

    {{!-- One push control and one conclusion, side by side, because those are the
          only two things a GM does to a Thread. --}}
    {{#if this.canPush}}
    <div class="rsr-controls rsr-controls-foot">
        {{#if this.discounted}}
        <span class="rsr-discount" data-tooltip="{{localize 'RSR.thread.discountHint'}}">
            <i class="fa-solid fa-tag" inert></i> {{this.discounted}}
        </span>
        {{/if}}
        {{#if this.isFull}}
        <span class="rsr-ready">{{localize "RSR.thread.ready"}}</span>
        {{/if}}
        <button type="button" class="rsr-mini" data-action="pushThread"
                name="push-{{this.id}}" data-thread-id="{{this.id}}"
                data-tooltip="{{localize 'RSR.editor.pushHint'}}">
            <i class="{{this.pushIcon}}" inert></i>
            <span>{{localize "RSR.editor.push"}}</span>
        </button>
        {{#if this.canConclude}}
        <button type="button" class="rsr-mini rsr-mini-primary" data-action="concludeThread"
                data-thread-id="{{this.id}}">
            <i class="fa-solid fa-gavel" inert></i>
            <span>{{localize "RSR.editor.conclude"}}</span>
        </button>
        {{/if}}
    </div>
    {{/if}}

</li>
